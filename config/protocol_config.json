{
  "study_domain": {
    "name": "Greater North Sea",
    "spatial_source": "ICES Ecoregions (Greater North Sea)",
    "crs": "EPSG:4326",
    "depth_convention": "positive_down_meters",
    "time_convention": {
      "timezone": "UTC",
      "format": "%Y-%m-%dT%H:%M:%SZ"
    },
    "station_assignment_rule": "point_in_polygon_with_0.05deg_buffer_centroid_tiebreak",
    "regions": {
      "southern_and_central_north_sea": "core-domain",
      "skagerrak_kattegat": "external-transfer"
    }
  },
  "provenance_rules": {
    "checksum_algorithm": "sha256",
    "identifier_prefixes": {
      "dataset": "DS",
      "search_run": "SEARCH",
      "source_record": "REC",
      "sample": "SMP",
      "station": "STN",
      "taxon_record": "TAX",
      "observation_window": "WIN",
      "event": "EVT",
      "year": "YR",
      "network": "NET",
      "subregion": "REG",
      "model_file": "MOD"
    }
  }
}
