  "purpose": "Define record identity, immutable-file provenance, legal-access state, record-level eligibility, and duplicate linkage before any shortlisted observation file is downloaded or inspected.",
  "phy_c_boundary": {
    "statement": "No CMEMS PhyC value, file, matchup, or performance measure is an input to Stage 2 acquisition or screening.",
    "prohibited_fields": ["phyc", "phyc_value", "phyc_performance", "model_agreement", "bloom_prediction"],
    "next_permitted_stage": 8
  },
  "raw_storage": {
    "repository_link": "data/raw",
    "required_resolved_target": "/mnt/hdd/publication-2026-north-sea-phyc-validation/",
    "immutable": true,
    "creation_rule": "Only version-controlled scripts under scripts/00_downloads may create raw files.",
    "overwrite_rule": "Never overwrite a verified raw file; changed provider content receives a new versioned path."
  },
  "decision_rules": {
    "shortlist_order_is_mandatory": true,
    "shortlist_is_not_eligibility": true,
    "provider_version_precedes_aggregator_copy": true,
    "title_only_geography_can_set_final_decision": false,
    "missing_or_inadequate_evidence_state": "pending",
    "contact_required_treatment": "unavailable",
    "unknown_is_never_negative": true,
    "aggregator_copy_counts_as_independent_network": false,
    "final_inclusion_requires": [
      "verified_raw_file",
      "usable_licence_state",
      "parseable_date_or_datetime",
      "parseable_coordinates_or_verified_fixed_station",
      "record_level_core_or_external_transfer_intersection",
      "repeated_sampling_or_prespecified_method_comparison_role",
      "method_metadata_sufficient_for_assigned_role"
    ]
  },
  "controlled_vocabularies": {
    "licence_state": ["open", "unverified", "contact_required", "restricted", "unreleased"],
